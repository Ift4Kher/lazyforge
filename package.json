{
  "name": "lazyforge-platform",
  "version": "1.0.0",
  "description": "LazyForge Technologies — Complete Production-Ready E-Commerce Platform",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run start --prefix backend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "npm run dev:backend",
    "test:backend": "npm run test --prefix backend",
    "test:frontend": "npm run test --prefix frontend",
    "test": "npm run test:backend && npm run test:frontend",
    "db:migrate": "npm run db:migrate --prefix backend",
    "db:seed": "npm run db:seed --prefix backend"
  },
  "keywords": [
    "ecommerce",
    "react",
    "express",
    "mysql",
    "threejs",
    "lazyforge"
  ],
