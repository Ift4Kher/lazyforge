# LazyForge Technologies — Environment Configuration Template
NODE_ENV=development
PORT=5000

# Database Configuration (XAMPP MariaDB default: user=root, password empty)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lazyforge_db
DB_TEST_NAME=lazyforge_test_db

# Security & Authentication
JWT_SECRET=lazyforge_super_secure_jwt_secret_change_in_production_2026_xyz
JWT_EXPIRES_IN=7d
COOKIE_SECRET=lazyforge_cookie_signing_secret_998877

# CORS Allowed Origins (Comma separated)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# Payment Gateway - SSLCommerz (Sandbox Defaults)
SSLCOMMERZ_STORE_ID=lazyf67890sandbox
SSLCOMMERZ_STORE_PASSWORD=lazyf67890sandbox@ssl
SSLCOMMERZ_IS_SANDBOX=true
SSLCOMMERZ_SUCCESS_URL=http://localhost:5000/api/v1/payments/sslcommerz/success
SSLCOMMERZ_FAIL_URL=http://localhost:5000/api/v1/payments/sslcommerz/fail
SSLCOMMERZ_CANCEL_URL=http://localhost:5000/api/v1/payments/sslcommerz/cancel
SSLCOMMERZ_IPN_URL=http://localhost:5000/api/v1/payments/sslcommerz/ipn

# File Storage
UPLOAD_DIR=../uploads
MAX_FILE_SIZE_BYTES=52428800
